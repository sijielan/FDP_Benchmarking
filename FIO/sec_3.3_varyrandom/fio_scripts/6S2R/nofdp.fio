# 6S2R (6 seq + 2 rand), Conv.
# Based on 8_incremental_Allseq (incremental_workloads/default/nofdp/2025-09-07_024943_single_test/.../updated.fio)
# Only change: rw=randwrite added to random jobs: write-1, write-2

[global]

ioengine=io_uring_cmd

cmd_type=nvme

filename=/dev/ng0n2



rw=write

bs=128K

iodepth=256

fdp=0



log_avg_msec=60000

write_bw_log=./log/compare_fdp_seq_bw

write_lat_log=./log/compare_fdp_seq_lat

write_iops_log=./log/compare_fdp_seq_iops



time_based=1

runtime=8h



[write-1]

#fdp_pli=0

offset=0

size=2%
rw=randwrite



[write-2]

#fdp_pli=1

offset=2%

size=5%
rw=randwrite



[write-3]

#fdp_pli=2

offset=7%

size=8%



[write-4]

#fdp_pli=3

offset=15%

size=11%



[write-5]

#fdp_pli=4

offset=26%

size=14%



[write-6]

#fdp_pli=5

offset=40%

size=17%



[write-7]

#fdp_pli=6

offset=57%

size=20%



[write-8]

#fdp_pli=7

offset=77%

size=23%