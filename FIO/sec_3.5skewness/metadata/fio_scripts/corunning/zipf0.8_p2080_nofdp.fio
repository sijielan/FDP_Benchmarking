[global]
ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng0n1
rw=randwrite
bs=4k
iodepth=64
time_based=1
runtime=8h
group_reporting=1
fdp=0             
numjobs=1


# Uniform distribution (skew=0)
[skew_0]
offset=0
size=20%
random_distribution=random

[skew_1.]
offset=20%
size=80%
random_distribution=zipf:0.8
