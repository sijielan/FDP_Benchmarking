[global]

ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng1n1

rw=write
bs=128K
iodepth=256
fdp=1

log_avg_msec=60000
write_bw_log=./compare_fdp_seq_bw
write_lat_log=./compare_fdp_seq_lat
write_iops_log=./compare_fdp_seq_iops

time_based=1
runtime=4h

# FDP-H64: 64个job，每RUH 8个job，size差距最大化
# 配对策略: (pool0↔pool7) + (pool1↔pool6) + (pool2↔pool5) + (pool3↔pool4)
# 每个RUH均包含全部8种size各1个，ratio=11.5x
# job的offset/size与原始FDP-U64均分布局相同，仅fdp_pli重新分配

########################################
# 新RUH 0  ratio=11.5x
# sizes: 9157MB 22893MB 36628MB 50364MB 64100MB 77835MB 91571MB 105306MB
########################################

[write-0-1]
fdp_pli=0
offset=0
size=9601888256
# orig: RUH0-job1  (9157.1 MB)

[write-0-2]
fdp_pli=0
offset=76815118336
size=24004722688
# orig: RUH1-job1  (22892.7 MB)

[write-0-3]
fdp_pli=0
offset=268852916224
size=38407557120
# orig: RUH2-job1  (36628.3 MB)

[write-0-4]
