[global]

ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng1n1

rw=write
bs=128K
iodepth=256
fdp=1

log_avg_msec=60000
write_bw_log=./compare_fdp_seq_bw
write_lat_log=./compare_fdp_seq_lat
write_iops_log=./compare_fdp_seq_iops

time_based=1
runtime=4h

# 总job数=24，每RUH 3个job
# 策略：同一RUH内size差距最大化，job的offset/size与原始均分布局相同，仅fdp_pli重新分配

########################################
# 新RUH 0  ratio=11.5x
# sizes: 24419MB 24419MB 280817MB
########################################

[write-0-1]
fdp_pli=0
offset=0
size=25605038080
# orig: RUH0-job1  (24418.9 MB)

[write-0-2]
fdp_pli=0
offset=25605038080
size=25605038080
# orig: RUH0-job2  (24418.9 MB)

[write-0-3]
fdp_pli=0
offset=2957382098944
size=294457958400
