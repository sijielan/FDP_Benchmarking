[global]

ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng1n1

rw=write
bs=128K
iodepth=256
fdp=1

log_avg_msec=60000
write_bw_log=./compare_fdp_seq_bw
write_lat_log=./compare_fdp_seq_lat
write_iops_log=./compare_fdp_seq_iops

time_based=1
runtime=4h

# 总job数=32，每RUH 4个job
# 策略：同一RUH内size差距最大化，job的offset/size与原始均分布局相同，仅fdp_pli重新分配

########################################
# 新RUH 0  ratio=11.5x
# sizes: 18314MB 18314MB 210613MB 210613MB
########################################

[write-0-1]
fdp_pli=0
offset=0
size=19203776512
# orig: RUH0-job1  (18314.1 MB)

