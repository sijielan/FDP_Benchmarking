[global]

ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng1n1

rw=write
bs=128K
iodepth=256
fdp=1

log_avg_msec=60000
write_bw_log=./compare_fdp_seq_bw
write_lat_log=./compare_fdp_seq_lat
write_iops_log=./compare_fdp_seq_iops

time_based=1
runtime=4h

# 最优重分配方案：job的offset/size与原fdp_fio_6jobs.fio完全相同，仅fdp_pli重新分配
# 目标：每个RUH内6个job的size差距最大化
# RUH0~5: ratio=11.5x (含最小12209MB和最大140408MB)
# RUH6:   ratio=2.5x  (含次小48837MB和次大122094MB)
# RUH7:   ratio=1.3x  (只剩中间两种size，数学约束，无法再优化)

########################################
# 新RUH 0  ratio=11.5x
# sizes: 12209MB 30524MB 48838MB 103780MB 122094MB 140408MB
########################################

[write-0-1]
fdp_pli=0
offset=0
size=12802519040
# orig: RUH0-job1  (12209.4 MB)

[write-0-2]
fdp_pli=0
offset=76815118336
size=32006299648
# orig: RUH1-job1  (30523.6 MB)

[write-0-3]
fdp_pli=0
