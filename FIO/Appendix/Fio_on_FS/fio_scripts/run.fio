[global]
ioengine=io_uring
cmd_type=nvme
direct=1
runtime=172800
time_based

[short]
rw=write
bs=128k
directory=/mnt/fdp/short/
nrfiles=1200
filesize=100m
openfiles=130
create_on_open=1
iodepth=1
write_hint=short

[medium]
rw=write
bs=64k
directory=/mnt/fdp/medium/
nrfiles=1800
filesize=64m
openfiles=200
create_on_open=1
iodepth=1
write_hint=medium

[long]
rw=write
bs=8k
directory=/mnt/fdp/long/
nrfiles=4000
filesize=24m
openfiles=1000
create_on_open=1
iodepth=1
write_hint=long

[extreme]
rw=randwrite
bs=4k
directory=/mnt/fdp/extreme/
nrfiles=2000
filesize=24m
iodepth=1
write_hint=extreme
