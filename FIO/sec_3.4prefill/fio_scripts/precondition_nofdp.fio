# Stage 1/3 - precondition (Conv.): sequential write the whole device 3 times
# Run once before EVERY prefill level (the device is rewritten from scratch each time)
# FDP: all preconditioned data goes to the cold RUH (fdp_pli=0)

[global]

ioengine=io_uring_cmd

cmd_type=nvme

filename=/dev/ng0n2



rw=write

bs=128K

iodepth=256

fdp=0



[precondition]

#fdp_pli=0

offset=0

size=100%

loops=3
