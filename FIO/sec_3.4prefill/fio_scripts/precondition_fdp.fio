# Stage 1/3 - precondition (FDP): sequential write the whole device 3 times
# Run once before EVERY prefill level (the device is rewritten from scratch each time)
# FDP: all preconditioned data goes to the cold RUH (fdp_pli=0)

[global]

ioengine=io_uring_cmd

cmd_type=nvme

filename=/dev/ng1n1



rw=write

bs=128K

iodepth=256

fdp=1



[precondition]

fdp_pli=0

offset=0

size=100%

loops=3
