[global]
ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng0n1
rw=randwrite
bs=4k
iodepth=64
time_based=1
runtime=8h
group_reporting=1
fdp=1            
numjobs=1


# Uniform distribution (skew=0)
#[skew_0.0]
#offset=50%
#size=50%
#random_distribution=random
#fdp_pli=0,1




[skew_0]
offset=0
size=80%
random_distribution=random
fdp_pli=0

[skew_0.6]
offset=80%
size=20%
random_distribution=zipf:0.8
fdp_pli=1



