[global]

ioengine=io_uring_cmd
cmd_type=nvme
filename=/dev/ng1n1

rw=write
bs=128K
iodepth=256
fdp=0

log_avg_msec=60000
write_bw_log=./compare_fdp_seq_bw
write_lat_log=./compare_fdp_seq_lat
write_iops_log=./compare_fdp_seq_iops

time_based=1
runtime=8h

# U-FDP-16: 16 jobs, 2 jobs per RUH, split evenly

